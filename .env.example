# ── Cómo usar este archivo ─────────────────────────────────────────────
# Copiar a `apps/<app>/.env.local` (gitignored) en local, y crear las mismas
# claves como "Environment Variables" en cada proyecto de Vercel.
# Ojo: las NEXT_PUBLIC_* se inyectan EN EL BUILD → si cambian, redeployar.
#
# Valores de producción (cuando existan los dominios):
#   NEXT_PUBLIC_LOGIN_URL=https://login.makced.online
#   NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.makced.online
#   NEXT_PUBLIC_TIENDA_URL=https://store.makced.online
#   DASHBOARD_URL=https://dashboard.makced.online
#
# Generar secrets de producción con:  openssl rand -hex 32
#   - PREVIEW_SECRET: el MISMO valor en dashboard y store (vista previa).
#   - REVALIDATE_SECRET: el MISMO valor en dashboard y store.

# ── InsForge (las 3 apps) ──────────────────────────────────────────────
NEXT_PUBLIC_INSFORGE_URL=https://253fnuce.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=anon_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── URLs entre apps (local: http://localhost:<puerto>) ─────────────────
NEXT_PUBLIC_LOGIN_URL=http://localhost:3001
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3002
NEXT_PUBLIC_TIENDA_URL=http://localhost:3000

# ── apps/dashboard ─────────────────────────────────────────────────────
# (usa: NEXT_PUBLIC_LOGIN_URL, NEXT_PUBLIC_TIENDA_URL, los 2 secrets)
PREVIEW_SECRET=
REVALIDATE_SECRET=
# TTL de la vista previa en segundos (opcional; default 900 = 15 min)
# PREVIEW_TTL_SECONDS=900

# ── apps/store ─────────────────────────────────────────────────────────
# (usa: NEXT_PUBLIC_INSFORGE_*, NEXT_PUBLIC_TIENDA_URL, los 2 secrets)
# Origen exacto del dashboard permitido en `frame-ancestors` del CSP: sin
# esta clave en producción el iframe del editor de diseño NO podrá embeber
# la tienda (cae a http://localhost:3002).
DASHBOARD_URL=http://localhost:3002

# ── apps/login ─────────────────────────────────────────────────────────
# (usa: NEXT_PUBLIC_LOGIN_URL y NEXT_PUBLIC_DASHBOARD_URL)
